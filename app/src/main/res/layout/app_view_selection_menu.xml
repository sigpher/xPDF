<?xml version="1.0" encoding="utf-8"?>
<!-- 长按选区的浮动操作栏：复制 / 高亮 / 笔记 / 翻译 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_ll_selection_menu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/app_shape_selection_menu"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/app_tv_selection_copy"
        style="@style/AppSelectionMenuItem"
        android:text="@string/app_copy" />

    <TextView
        android:id="@+id/app_tv_selection_highlight"
        style="@style/AppSelectionMenuItem"
        android:text="@string/app_highlight" />

    <TextView
        android:id="@+id/app_tv_selection_underline"
        style="@style/AppSelectionMenuItem"
        android:text="@string/app_underline" />

    <TextView
        android:id="@+id/app_tv_selection_note"
        style="@style/AppSelectionMenuItem"
        android:text="@string/app_note" />

    <TextView
        android:id="@+id/app_tv_selection_translate"
        style="@style/AppSelectionMenuItem"
        android:text="@string/app_translate" />

</LinearLayout>
