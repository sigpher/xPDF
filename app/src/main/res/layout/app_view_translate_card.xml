<?xml version="1.0" encoding="utf-8"?>
<!-- 选中文本的译文卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_ll_translate_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_shape_translate_card"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/app_tv_translate_lang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/base_text_small"
            android:textColor="@color/base_white_shallow"
            tools:text="EN → 中文" />

        <ProgressBar
            android:id="@+id/app_pb_translate"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="12dp"
            android:indeterminateTint="@color/base_white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/app_tv_translate_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/base_white_shallow"
            android:textSize="@dimen/base_text_normal" />

    </LinearLayout>

    <TextView
        android:id="@+id/app_tv_translate_src"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="@dimen/base_text_small"
        android:textColor="@color/base_white_hint"
        tools:text="The quick brown fox jumps over the lazy dog." />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginTop="10dp"
        android:background="#26FFFFFF" />

    <TextView
        android:id="@+id/app_tv_translate_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="8"
        android:textColor="@color/base_white"
        android:textSize="@dimen/base_text_large"
        tools:text="敏捷的棕色狐狸跳过了懒狗。" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/app_tv_translate_external"
            style="@style/AppSelectionMenuItem"
            android:text="@string/app_translate_external" />

        <TextView
            android:id="@+id/app_tv_translate_retry"
            style="@style/AppSelectionMenuItem"
            android:text="@string/app_retry" />

        <TextView
            android:id="@+id/app_tv_translate_lang_toggle"
            style="@style/AppSelectionMenuItem"
            tools:text="中文" />

        <TextView
            android:id="@+id/app_tv_translate_copy"
            style="@style/AppSelectionMenuItem"
            android:text="@string/app_copy_translation" />

    </LinearLayout>

</LinearLayout>
